[Unit]
Description=Wait until web-loopback.service is ready
After=runtime-init-owners.service web-loopback.service
Requires=runtime-init-owners.service web-loopback.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c "until (exec 3<>/dev/tcp/127.0.0.1/8090) 2>/dev/null; do sleep 0.5; done"
User=web-loopback-ready
TimeoutStartSec=90s
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@setuid
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=minimal.target
