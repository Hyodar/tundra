#!/bin/sh
# tundravm Container box: this boot's SSH host key, owned by the container's user, and
# the directory its delivered keys land in; its sshd binds both read-only.
set -eu
mkdir -p -m 0711 /run/tundravm /run/tundravm/containers /run/tundravm/containers/box
mkdir -p -m 0755 /run/tundravm/containers/box/host /run/tundravm/containers/box/keys
if [ ! -s /run/tundravm/containers/box/host/ssh_host_ed25519_key ] || [ ! -s /run/tundravm/containers/box/host/ssh_host_ed25519_key.pub ]; then
    rm -f /run/tundravm/containers/box/host/ssh_host_ed25519_key /run/tundravm/containers/box/host/ssh_host_ed25519_key.pub
    ssh-keygen -q -t ed25519 -N '' -C box -f /run/tundravm/containers/box/host/ssh_host_ed25519_key
fi
chmod 0600 /run/tundravm/containers/box/host/ssh_host_ed25519_key
chown 60852:60852 /run/tundravm/containers/box/host/ssh_host_ed25519_key
echo "tundravm-container-ssh: box $(ssh-keygen -l -f /run/tundravm/containers/box/host/ssh_host_ed25519_key.pub | cut -d ' ' -f 2)"
