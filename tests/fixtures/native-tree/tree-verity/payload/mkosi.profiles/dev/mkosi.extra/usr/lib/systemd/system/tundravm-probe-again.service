[Unit]
Description=Check again once a held volume opens
After=tundravm-probe.service runtime-init-volume-vault.service ledger.service ledger-ready.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /usr/lib/tundravm/probe again
TimeoutStartSec=10min
StandardOutput=journal+console

[Install]
WantedBy=tundravm-held.target
