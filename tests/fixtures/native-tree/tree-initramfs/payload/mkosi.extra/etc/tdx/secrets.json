{
  "host": "0.0.0.0",
  "method": "http_post",
  "port": 8745,
  "secrets": [
    {
      "name": "greeting-token",
      "required": false,
      "targets": [
        {
          "kind": "file",
          "location": "/run/tundravm/credentials/greeting-token",
          "mode": "0600"
        }
      ]
    },
    {
      "name": "tenant-keys",
      "required": false,
      "targets": [
        {
          "kind": "file",
          "location": "/run/tundravm/credentials/tenant-keys",
          "mode": "0600"
        },
        {
          "kind": "file",
          "location": "/etc/ssh/authorized_keys.d/tenant",
          "mode": "0644"
        }
      ]
    }
  ]
}
