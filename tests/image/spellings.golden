== payload/mkosi.extra/usr/lib/systemd/system/ssh.service.d/20-tundravm.conf
[Unit]
After=tdx-evidence.service
Requires=tdx-evidence.service

[Service]
Environment=SSHD_OPTS=-e
ProtectSystem=full
ProtectHome=no
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=no
PrivateDevices=no
DevicePolicy=auto
DeviceAllow=
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=no
RestrictRealtime=no
RestrictNamespaces=no
LockPersonality=no
RestrictAddressFamilies=
SystemCallArchitectures=
SystemCallFilter=
CapabilityBoundingSet=
CapabilityBoundingSet=~
AmbientCapabilities=
UMask=0022
== enabled
mkosi-chroot useradd --system --shell /usr/sbin/nologin prometheus-node-exporter-ready
mkosi-chroot systemctl enable prometheus-node-exporter.service
mkosi-chroot systemctl enable prometheus-node-exporter-ready.service
mkosi-chroot systemctl enable ssh.service
ln -sf "/etc/systemd/system/prometheus-node-exporter.service" "$BUILDROOT/etc/systemd/system/minimal.target.wants/"
ln -sf "/etc/systemd/system/prometheus-node-exporter-ready.service" "$BUILDROOT/etc/systemd/system/minimal.target.wants/"
ln -sf "/etc/systemd/system/ssh.service" "$BUILDROOT/etc/systemd/system/minimal.target.wants/"
