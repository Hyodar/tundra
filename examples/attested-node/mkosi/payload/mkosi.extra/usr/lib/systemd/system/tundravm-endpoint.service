[Unit]
Description=tundravm attested endpoint
After=network-online.target tdx-evidence.service tdxs.socket ssh-host-keys.service tundravm-instance-key.service attested-tls-8546-key.service tundravm-volume-owner.service
Wants=network-online.target tdxs.socket tundravm-volume-owner.service

[Service]
Type=notify
ExecStart=/usr/bin/attested-endpoint --config /etc/tdx/secrets.yaml
ReadWritePaths=-/root -/run/tundravm
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=no
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN

[Install]
WantedBy=minimal.target
