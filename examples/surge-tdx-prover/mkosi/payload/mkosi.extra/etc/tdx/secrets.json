  "method": "http_post",
  "port": 8745,
  "secrets": [
    {
      "name": "jwt",
      "required": true,
      "targets": [
        {
          "kind": "file",
          "location": "/run/tundravm/credentials/jwt",
          "mode": "0600"
        }
      ]
    },
    {
      "name": "raiko-config",
      "required": true,
      "targets": [
        {
          "kind": "file",
          "location": "/run/tundravm/credentials/raiko-config",
          "mode": "0600"
        }
      ]
    },
    {
      "name": "taiko-chain",
      "required": true,
      "targets": [
        {
          "kind": "file",
          "location": "/run/tundravm/credentials/taiko-chain",
          "mode": "0600"
        }
      ]
    }
  ]
