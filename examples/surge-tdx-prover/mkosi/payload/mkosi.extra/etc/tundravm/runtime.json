{
  "control_plane": "attested endpoint: TLS bound to the quote",
  "ingress": [
    {
      "binding": "self-signed per boot; quote binding is gate 3",
      "kind": "attested-tls",
      "port": 443,
      "unit": "attested-tls-443.service",
      "upstream": "http://127.0.0.1:8080/"
    }
  ],
  "management_port": 8745,
  "rootfs": "verity",
  "schema": 1,
  "secrets": [
    {
      "location": "/run/tundravm/credentials/jwt",
      "name": "jwt",
      "required": true,
      "rotation": "restart",
      "source": null,
      "units": [
        "nethermind.service",
        "taiko-client.service"
      ]
    },
    {
      "location": "/run/tundravm/credentials/taiko-chain",
      "name": "taiko-chain",
      "required": true,
      "rotation": "restart",
      "source": null,
      "units": [
        "taiko-client.service"
      ]
    },
    {
      "location": "/run/tundravm/credentials/raiko-config",
      "name": "raiko-config",
      "required": true,
      "rotation": "restart",
      "source": null,
      "units": [
        "raiko.service"
      ]
    }
  ],
  "volumes": [
    {
      "device": "/dev/disk/by-id/*-tundravm-data",
      "directories": [
        "/persistent/data/nethermind",
        "/persistent/data/raiko"
      ],
      "filesystem": "ext4",
      "mount": "/persistent/data",
      "name": "data",
      "pipe": "/run/tundravm/unlock/data",
      "serial": "tundravm-data",
      "unlock": {
        "kind": "operator-key"
      }
    }
  ]
}
