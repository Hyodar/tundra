#!/bin/sh
# tundravm instance key: a fresh secp256k1 key every boot, on tmpfs only. The private key is
# root:root 0600; services read it through LoadCredential=, nothing else.
set -eu
pub_of() {
    openssl ec -in "$1" -pubout -conv_form compressed -outform DER 2>/dev/null |
        tail -c 33 | od -An -v -tx1 | tr -d ' \n'
}
mkdir -p -m 0711 /run/tundravm
if [ -s /run/tundravm/instance-key.pem ] && [ -s /run/tundravm/instance-key.pub ]; then
    echo "tundravm-instance-key: pub $(cat /run/tundravm/instance-key.pub)"
    exit 0
fi
umask 077
openssl ecparam -name secp256k1 -genkey -noout -out /run/tundravm/instance-key.pem.tmp
pub=$(pub_of /run/tundravm/instance-key.pem.tmp)
if [ "${#pub}" -ne 66 ] || [ "${pub#0[23]}" = "$pub" ]; then
    echo "tundravm-instance-key: failed: openssl made no secp256k1 key"
    exit 1
fi
printf '%s\n' "$pub" > /run/tundravm/instance-key.pub.tmp
chmod 0644 /run/tundravm/instance-key.pub.tmp
mv /run/tundravm/instance-key.pem.tmp /run/tundravm/instance-key.pem
mv /run/tundravm/instance-key.pub.tmp /run/tundravm/instance-key.pub
echo "tundravm-instance-key: pub $pub"
