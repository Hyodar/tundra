# tundravm Container bob: its network namespace and a veth the firewall forwards
[Unit]
Description=Network namespace of container bob
DefaultDependencies=no
Requires=nftables.service
After=nftables.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=net mnt
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
ExecStartPre=-/usr/bin/ip link delete ve-bob
ExecStartPre=-/usr/bin/ip netns delete bob
ExecStart=/usr/bin/ip netns add bob
ExecStart=/usr/bin/ip -n bob link set lo up
ExecStart=/usr/bin/ip link add ve-bob type veth peer name host0 netns bob
ExecStart=/usr/bin/ip addr add 169.254.222.97/30 dev ve-bob
ExecStart=/usr/bin/ip link set ve-bob up
ExecStart=/usr/bin/ip -n bob addr add 169.254.222.98/30 dev host0
ExecStart=/usr/bin/ip -n bob link set host0 up
ExecStart=/usr/bin/ip -n bob route add default via 169.254.222.97
ExecStop=-/usr/bin/ip link delete ve-bob
ExecStop=/usr/bin/ip netns delete bob
