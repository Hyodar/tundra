[Unit]
Description=lighthouse.service
After=nethermind-ready.service tundravm-generated-jwt.service runtime-init-volume-data.service tdx-evidence.service
Requires=nethermind-ready.service tundravm-generated-jwt.service runtime-init-volume-data.service tdx-evidence.service

[Service]
Type=exec
ExecStart=/usr/lib/lighthouse/lighthouse bn --network=mainnet --datadir=/persistent/data/lighthouse --execution-endpoint=http://127.0.0.1:8551/ --execution-jwt=${CREDENTIALS_DIRECTORY}/jwt --http --http-address=127.0.0.1 --http-port=5052 --port=9000 --disable-upnp --disable-quic --disable-optimistic-finalized-sync --state-cache-size=32 --checkpoint-sync-url=https://mainnet.checkpoint.sigp.io
User=lighthouse
WorkingDirectory=/persistent/data/lighthouse
Environment=STATE_DIRECTORY=/persistent/data/lighthouse
LoadCredential=jwt:/run/tundravm/secrets/jwt
ReadWritePaths=-/persistent/data/lighthouse
Restart=on-failure
RestartSec=5s
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@setuid
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=tundravm-held.target
