[Unit]
Description=Power off on the ACPI power button

[Service]
Type=simple
ExecStart=/usr/sbin/acpid --foreground --netlink --nosocket --logevents --confdir /usr/lib/tundravm/acpi --pidfile /run/tundravm-power-button/acpid.pid
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
RuntimeDirectory=tundravm-power-button

[Install]
WantedBy=minimal.target
