[Unit]
Description=input-proxy.service
After=runtime-init-volume-data.service tdx-evidence.service
Requires=runtime-init-volume-data.service tdx-evidence.service

[Service]
Type=exec
ExecStart=/usr/bin/input-proxy 0.0.0.0:27018 /persistent/data/input/input.sock
User=searcher-container
WorkingDirectory=/persistent/data/input
Environment=STATE_DIRECTORY=/persistent/data/input
ReadWritePaths=-/persistent/data/input
Restart=on-failure
RestartSec=5s
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@setuid
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=tundravm-held.target
