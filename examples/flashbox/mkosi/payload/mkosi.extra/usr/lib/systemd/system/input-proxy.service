[Unit]
Description=Carry the owner's TLS input on 27018/tcp into the searcher's socket, one way
After=runtime-init-volume-data.service tdx-evidence.service
Requires=runtime-init-volume-data.service tdx-evidence.service

[Service]
Type=exec
ExecStart=/usr/bin/input-proxy -listen 0.0.0.0:27018 -socket /persistent/data/input/input.sock -key ${CREDENTIALS_DIRECTORY}/host-key -pin /run/tundravm/containers/bob/keys/authorized_keys
User=input-proxy
SupplementaryGroups=bob
WorkingDirectory=/persistent/data/input
Environment=STATE_DIRECTORY=/persistent/data/input
LoadCredential=host-key:/run/tundravm/containers/bob/host/ssh_host_ed25519_key
ReadWritePaths=-/persistent/data/input
Restart=on-failure
RestartSec=5s
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@setuid
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=tundravm-held.target
