{
  "host": "0.0.0.0",
  "method": "http_post",
  "port": 8745,
  "secrets": [
    {
      "name": "searcher-keys",
      "required": true,
      "targets": [
        {
          "kind": "file",
          "location": "/run/tundravm/credentials/searcher-keys",
          "mode": "0600"
        },
        {
          "kind": "file",
          "location": "/run/tundravm/containers/searcher-container/keys/authorized_keys",
          "mode": "0644"
        }
      ]
    }
  ]
}
